# ==============================================================================
# Pro mTLS Manager - Environment Configuration Template
# ==============================================================================
# Copy this file to `.env` and adjust the values for your Debian/Ubuntu host:
#   cp .env.example .env
#   chmod 600 .env
# ==============================================================================

# ------------------------------------------------------------------------------
# Server Settings
# ------------------------------------------------------------------------------
# Runtime mode: set to "production" when running under systemd after `npm run build`
NODE_ENV=production

# HTTP listen port and bind address
# Use 127.0.0.1 if placing Pro mTLS Manager behind Caddy on the same host
PORT=3000
HOST=0.0.0.0

# ------------------------------------------------------------------------------
# PKI Storage Directory (Required)
# ------------------------------------------------------------------------------
# Directory where the Root CA, client certificates, OpenSSL CRL index, and
# dashboard config are stored. Can be relative (./data) or absolute
# (e.g., /var/lib/pro-mtls-manager). Created automatically with 0700 permissions.
DATA_DIR=./data

# ------------------------------------------------------------------------------
# Root Certificate Authority (CA) Defaults
# ------------------------------------------------------------------------------
# Automatically generate a fresh Root CA on first startup if DATA_DIR/ca/ is empty.
# Set to "false" to configure and initialize the Root CA interactively in the UI.
CA_AUTO_INIT=true

# Subject fields used for auto-initialization and pre-filled in the UI setup wizard
CA_COMMON_NAME="My Private Root CA"
CA_ORGANIZATION="My Organization"
CA_ORGANIZATIONAL_UNIT="Internal PKI"
# 2-letter ISO 3166-1 alpha-2 country code (e.g., US, DE, GB, CA)
CA_COUNTRY=US
# Root CA validity duration in days (3650 = 10 years)
CA_VALIDITY_DAYS=3650
# Root CA RSA key size: 2048 or 4096
CA_KEY_SIZE=2048

# ------------------------------------------------------------------------------
# OpenSSL CRL & Local Caddy Integration
# ------------------------------------------------------------------------------
# Number of days a generated Certificate Revocation List (CRL) remains valid
CRL_VALIDITY_DAYS=30

# Optional: Full path on the local host where crl.pem is exported on every update
# (for bare-metal hosts running Caddy on the same machine).
# Leave empty to keep crl.pem only inside DATA_DIR/crl/crl.pem.
CRL_OUTPUT_PATH=/etc/caddy/certs/crl.pem

# Optional: Full path on the local host where ca.crt is exported on CA init
CA_CERT_OUTPUT_PATH=/etc/caddy/certs/ca.crt

# Command executed to reload Caddy after updating the CA/CRL.
# Requires a passwordless sudoers rule (see README.md for /etc/sudoers.d/pro-mtls).
CADDY_RELOAD_CMD="sudo systemctl reload caddy"

# Set to "true" to automatically execute CADDY_RELOAD_CMD locally whenever a
# certificate is revoked or deleted (only applies when CRL_OUTPUT_PATH is set).
CADDY_AUTO_RELOAD_LOCAL=false

# ------------------------------------------------------------------------------
# Remote Caddy (SSH) & Hostname Scoping Defaults
# ------------------------------------------------------------------------------
# Default remote directory shown in the Caddy SSH Sync panel
CADDY_REMOTE_CERTS_DIR=/etc/caddy/certs

# Comma-separated default allowed hostnames embedded as OU=host:<hostname>
# when issuing client certificates without explicit hostnames
DEFAULT_ALLOWED_HOSTS=*.example.com

# Optional: Path to a local SSH private key used as fallback for remote Caddy sync
# SSH_KEY_PATH=/home/pro-mtls/.ssh/id_ed25519

# ------------------------------------------------------------------------------
# Dashboard Security
# ------------------------------------------------------------------------------
# Custom salt used when hashing the optional dashboard passcode.
# Generate a random value with: openssl rand -hex 24
AUTH_SALT=change-me-to-a-random-hex-string
